[sub_resource type="GDScript" id="GDScript_mu1a1"]
script/source = "extends Node2D
var speed = 400

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	position.x -= speed * delta


func _on_body_entered(body):
	body.player_hit()
"

